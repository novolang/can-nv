// canhal.nv — the peripheral trait, and the boards that have one.
//
// `CanPeripheral[e]` is the trait every controller in this package
// satisfies, in the shape of Rust's `embedded-can`: transmit, receive,
// the two questions a driver asks about state, and recovery.
// `CanFdPeripheral[e]` is its CAN FD half.  Three implementations ship
// with the package: `canloop.CanLoop` (`[mutate]`, a controller in
// memory), `canbxcan.BxCan` and `canfdcan.FdCan` (`[hw]`, the STM32
// controllers).  A program written against the trait runs on any of
// them, and a function written over it is charged what its argument
// costs.
//
// Which boards have a controller on the die: the STM32F407G-DISC1
// (bxCAN, CAN1 and CAN2) and the NUCLEO-H723ZG (FDCAN1 to FDCAN3).  The
// nRF52 and nRF53 parts and the RP2040 and RP2350 have none; a board
// built on one of those needs an external controller over SPI, the
// MCP2515 for classic CAN or the MCP2518FD for FD, which this package
// does not drive.  `controller_of` answers for a board or a part
// family, and `CAN_CONTROLLER_*` names the controllers.
//
// TRANSMISSION IS NOT COMPLETION.  `can_transmit` answers a MAILBOX
// index, not "sent": a CAN controller accepts a frame into a mailbox
// and arbitrates for the bus afterwards, which can take arbitrarily
// long on a busy bus and can fail.  A trait whose transmit answered
// `Result<(), E>` would have to block, and a driver that blocks in an
// interrupt handler is a driver that misses frames.  `can_tx_done` is
// the second half, and `cantxq` is what sits behind it.
//
// A MAILBOX DISPLACEMENT IS NOT AN ERROR EITHER.  Every controller
// with more than one transmit mailbox will, when they are all full,
// abort the lowest-priority pending frame to make room for a
// higher-priority one — and the aborted frame's index comes back so
// the caller can requeue it.  That is `CanTxAccepted`'s second field,
// and a trait that hid it would lose frames silently.

use canframe
use canfilter
use canbus
use canerr

// ── What a transmit attempt answers ──────────────────────────────────

// Whether a mailbox took the frame, which one, and which frame it
// displaced.
//
// THE ACCEPTANCE CARRIES ITS OWN REFUSAL.  A `@value` struct cannot be
// a `Result` payload (E2015) and this has to be answerable from an
// interrupt with nothing on a heap, so `status` is one of the
// `CAN_TX_*` codes and `tx_fault` turns a refusal into words.  That is
// the same trade every fallible answer in this package makes.
pub @value
struct CanTxAccepted
    // One of the `CAN_TX_*` codes.
    status: Int
    // The mailbox the frame went into, or -1.
    mailbox: Int
    // The mailbox whose pending frame was aborted to make room, or -1
    // when nothing was displaced.  A driver requeues that frame; one
    // that ignores this field loses it, silently, only under load.
    displaced: Int

// A mailbox took the frame.
pub const CAN_TX_ACCEPTED = 0
// Every mailbox is occupied by a frame that outranks this one.
pub const CAN_TX_FULL = 1
// The node is bus-off and may not transmit at all.
pub const CAN_TX_BUS_OFF = 2
// The frame itself is not one this bus can carry — an FD frame on a
// classic controller, an identifier too wide for its format.
pub const CAN_TX_REFUSED = 3

// Build an acceptance.
pub @tier(embedded)
fn accepted(mailbox: Int, displaced: Int) -> CanTxAccepted []
    CanTxAccepted { status: CAN_TX_ACCEPTED, mailbox: mailbox, displaced: displaced }

// A refusal with the given `CAN_TX_*` status.
pub @tier(embedded)
fn tx_refused(status: Int) -> CanTxAccepted []
    CanTxAccepted { status: status, mailbox: 0 - 1, displaced: 0 - 1 }

// Whether a mailbox took the frame.
pub @tier(embedded)
fn tx_ok(a: CanTxAccepted) -> Bool []
    a.status == CAN_TX_ACCEPTED

// The `CAN_TX_*` status.
pub @tier(embedded)
fn tx_status(a: CanTxAccepted) -> Int []
    a.status

// Why the frame was refused, or nothing.
pub @tier(rt)
fn tx_fault(a: CanTxAccepted) -> ?CanError []
    if a.status == CAN_TX_ACCEPTED
        return None
    if a.status == CAN_TX_FULL
        return Some(CanQueueFull(0))
    if a.status == CAN_TX_BUS_OFF
        return Some(CanBusOff)
    Some(CanFrameRefused)

// Which mailbox took the frame.
pub @tier(embedded)
fn accepted_mailbox(a: CanTxAccepted) -> Int []
    a.mailbox

// Which pending frame was displaced, or -1.
pub @tier(embedded)
fn accepted_displaced(a: CanTxAccepted) -> Int []
    a.displaced

// Whether anything was displaced.
pub @tier(embedded)
fn accepted_displaced_any(a: CanTxAccepted) -> Bool []
    a.displaced >= 0

// ── The trait ────────────────────────────────────────────────────────

// A CAN controller, on a die or behind a socket.
//
// `e` is the effect row the implementation supplies: `[hw]` for a
// peripheral driver over `orbit/hal`, `[net]` for `cansocket`'s
// SocketCAN, `[hw, io]` for an MCP2515 over SPI with a chip-select
// line, and NOTHING for a table in a test.  Every function written
// over this trait costs what its argument costs (SPEC § 5.6).
pub trait CanPeripheral[e]
    // Hand a frame to a transmit mailbox.  The answer says which
    // mailbox took it and what it displaced; it does NOT say the frame
    // reached the bus.
    fn can_transmit(self, f: CanFrame) -> CanTxAccepted [e]
    // Whether the frame in `mailbox` has reached the bus.
    fn can_tx_done(self, mailbox: Int) -> Bool [e]
    // Abort a pending transmission.  What a driver does when a
    // deadline passes, and the operation a queue cannot be correct
    // without: a stale actuator command that finally wins arbitration
    // three seconds late is worse than one that was never sent.
    fn can_tx_abort(self, mailbox: Int) -> ?CanError [e]
    // Take the next received frame.
    //
    // Answers `canframe.none()` when the bus was quiet and a FAULT
    // frame when the controller reported one — a `@value` struct
    // cannot be an optional or a `Result` payload (E2015), so the
    // frame carries its own status and `canframe.is_none` and
    // `canframe.is_fault` are the two questions a receive loop asks.
    //
    // NOT A BLOCKING READ.  A device driver is called from an
    // interrupt and a host driver from a poll loop, and a blocking
    // read would make the first impossible; a caller that wants to
    // wait waits on its own terms.
    fn can_receive(self) -> CanFrame [e]
    // Program one hardware acceptance filter.
    //
    // `slot` is the controller's own filter index, and how many there
    // are is the controller's business — `canfilter.merge` is what a
    // driver with more filters than slots uses.
    fn can_set_filter(self, slot: Int, f: CanFilter) -> ?CanError [e]
    // How many hardware filter slots this controller has.  Answered
    // without performing anything, because a driver asks it once at
    // startup and a question that cost `[hw]` would be a question a
    // caller caches.
    fn can_filter_slots(self) -> Int
    // The error counters and confinement state.  Reading a
    // controller's counters cannot fail, which is why this is the one
    // method with no way to refuse.
    fn can_bus_state(self) -> CanBusState [e]
    // Bring a bus-off controller back.  The one operation that is
    // neither transmit nor receive and that every controller needs,
    // because a node that has taken itself off the bus stays off until
    // something asks it to come back.
    fn can_recover(self) -> ?CanError [e]

// The CAN FD half of a controller: a frame of up to 64 bytes each way.
//
// A separate trait, because most controllers have no FD and a program
// written for classic CAN should not have to name methods it cannot
// call.  The payload is a `Vec[u8; 64]`, inline wherever the caller
// holds it; a transmit sends `canframe.fd_len(f)` bytes of it, padded
// with zeros to the length the data length code names, and a receive
// fills it and answers the header.  A classic frame received through
// `can_receive_fd` answers with `canframe.fd_is_fd` false.
pub trait CanFdPeripheral[e]
    // Hand an FD frame to a transmit mailbox.
    fn can_transmit_fd(self, f: CanFdFrame, data: Vec[u8; 64]) -> CanTxAccepted [e]
    // Take the next received frame, classic or FD, into `data`;
    // `canframe.fd_none()` when the bus was quiet.
    fn can_receive_fd(self, var data: Vec[u8; 64]) -> CanFdFrame [e]

// ── Driving one ──────────────────────────────────────────────────────

// Transmit a frame, refusing rather than trying when the node is
// bus-off.
//
// `[e]`, so the cost is the peripheral's.  The check is worth writing
// once here because a driver that omits it spins: a bus-off
// controller's transmissions never complete, so a retry loop around
// one never ends.
pub @tier(embedded)
fn transmit_checked<P: CanPeripheral[e]>(p: P, f: CanFrame) -> CanTxAccepted [e]
    if not canbus.may_transmit(p.can_bus_state())
        return tx_refused(CAN_TX_BUS_OFF)
    if not frame_ok(f)
        return tx_refused(CAN_TX_REFUSED)
    p.can_transmit(f)

// Take the next frame the filter accepts, discarding up to `limit`
// frames that it does not.
//
// The software half of filtering, for a driver with more filters than
// its controller has slots: the widened filter is in the hardware and
// the precise one is here.  A `CanFilter` rather than a predicate,
// because a `@value` struct cannot appear in a fn value's signature
// (E2015) — and because a filter value is what the hardware was
// programmed with, so the two halves cannot drift apart.
//
// Answers `canframe.none()` when `limit` frames went by without a
// match.
pub @tier(embedded)
fn receive_filtered<P: CanPeripheral[e]>(p: P, filt: CanFilter, limit: Int) -> CanFrame [e]
    for _i in 0..limit
        let f = p.can_receive()
        if not canframe.is_frame(f)
            return f
        if canfilter.accepts(filt, f)
            return f
    canframe.none()

// Recover a bus-off node, doing nothing when it is not bus-off.
pub @tier(embedded)
fn recover_if_bus_off<P: CanPeripheral[e]>(p: P) -> ?CanError [e]
    if canbus.may_transmit(p.can_bus_state())
        return None
    p.can_recover()

// ── Which parts have a controller ────────────────────────────────────

// No CAN controller on the die.  What the nRF52840 and the RP2040
// answer, and the reason a board built on either needs an MCP2515 or
// an MCP2518FD over SPI.
pub const CAN_CONTROLLER_NONE = 0
// STM32's bxCAN — classic CAN only, on the F1, F4 and L4 families.
pub const CAN_CONTROLLER_BXCAN = 1
// STM32's FDCAN — classic and FD, on the G0, G4, H7 and U5 families.
pub const CAN_CONTROLLER_FDCAN = 2
// NXP's FlexCAN — i.MX RT, S32K, LPC.
pub const CAN_CONTROLLER_FLEXCAN = 3
// Espressif's TWAI, which is a CAN 2.0B controller under a name that
// avoids the trademark.  Classic only.
pub const CAN_CONTROLLER_TWAI = 4
// Microchip's MCP2515: an external classic controller over SPI, and
// the usual answer for a board whose part has none.
pub const CAN_CONTROLLER_MCP2515 = 5
// Microchip's MCP2518FD: the same, with FD.
pub const CAN_CONTROLLER_MCP2518FD = 6
// Linux's SocketCAN, which is not a controller but is what a host
// program talks to.
pub const CAN_CONTROLLER_SOCKETCAN = 7

// What the named board carries.
//
// A function rather than a table in the README, so a build for a board
// with no controller can fail at compile time with a name in the
// message rather than at runtime on a bench.  `nrf52840-dk`,
// `nrf52832-dk` and `rp2040` all answer `CAN_CONTROLLER_NONE`, which
// is the fact this package most needs to state plainly.
//
// ```novo
// use canhal
//
// fn main() [io]
//     println("${canhal.controller_of("nrf52840-dk")}")   // 0, there is none
// ```
pub @tier(embedded)
fn controller_of(board: Str) -> Int []
    if board == "nrf52840-dk" or board == "nrf52832-dk" or board == "nrf5340-dk" or board == "rp2040" or board == "pico2" or board == "rp2350"
        return CAN_CONTROLLER_NONE
    if board == "socketcan" or board == "linux"
        return CAN_CONTROLLER_SOCKETCAN
    if board == "stm32f407g-disc1" or board == "stm32f3discovery"
        return CAN_CONTROLLER_BXCAN
    if board == "nucleo-h723zg"
        return CAN_CONTROLLER_FDCAN
    if board == "frdm-mcxn947"
        return CAN_CONTROLLER_FLEXCAN
    if board == "esp32-c6-devkitc-1"
        return CAN_CONTROLLER_TWAI
    if prefixed(board, "stm32f1") or prefixed(board, "stm32f2") or prefixed(board, "stm32f3") or prefixed(board, "stm32f4") or prefixed(board, "stm32f7") or prefixed(board, "stm32l4")
        return CAN_CONTROLLER_BXCAN
    if prefixed(board, "stm32g0") or prefixed(board, "stm32g4") or prefixed(board, "stm32h7") or prefixed(board, "stm32u5")
        return CAN_CONTROLLER_FDCAN
    if prefixed(board, "imxrt") or prefixed(board, "s32k") or prefixed(board, "lpc") or prefixed(board, "mcxn")
        return CAN_CONTROLLER_FLEXCAN
    if prefixed(board, "esp32")
        return CAN_CONTROLLER_TWAI
    CAN_CONTROLLER_NONE

// Whether a controller handles CAN FD.
pub @tier(embedded)
fn supports_fd(controller: Int) -> Bool []
    controller == CAN_CONTROLLER_FDCAN or controller == CAN_CONTROLLER_FLEXCAN or controller == CAN_CONTROLLER_MCP2518FD or controller == CAN_CONTROLLER_SOCKETCAN

// How many hardware acceptance filter slots a controller typically
// has.
//
// The number that decides whether `canfilter.merge` is needed:
// bxCAN has 14 banks shared between two instances, FlexCAN has 8 to
// 128 message buffers depending on the part, and the MCP2515 has 6.
// A driver asks this once and either programs its filters or widens
// them.
pub @tier(embedded)
fn filter_slots_of(controller: Int) -> Int []
    if controller == CAN_CONTROLLER_BXCAN
        return 14
    if controller == CAN_CONTROLLER_FDCAN
        return 28
    if controller == CAN_CONTROLLER_FLEXCAN
        return 16
    if controller == CAN_CONTROLLER_TWAI
        return 1
    if controller == CAN_CONTROLLER_MCP2515
        return 6
    if controller == CAN_CONTROLLER_MCP2518FD
        return 32
    if controller == CAN_CONTROLLER_SOCKETCAN
        return 512
    0

// A controller in words, for a log or a build diagnostic.
pub @tier(embedded)
fn controller_name(controller: Int) -> Str []
    if controller == CAN_CONTROLLER_BXCAN
        return "ST bxCAN"
    if controller == CAN_CONTROLLER_FDCAN
        return "ST FDCAN (Bosch M_CAN)"
    if controller == CAN_CONTROLLER_FLEXCAN
        return "NXP FlexCAN"
    if controller == CAN_CONTROLLER_TWAI
        return "Espressif TWAI"
    if controller == CAN_CONTROLLER_MCP2515
        return "Microchip MCP2515 over SPI"
    if controller == CAN_CONTROLLER_MCP2518FD
        return "Microchip MCP2518FD over SPI"
    if controller == CAN_CONTROLLER_SOCKETCAN
        return "Linux SocketCAN"
    "no CAN controller"

// Whether a frame is one a bus can carry, asked without building the
// reason: a `?CanError` with a payload is a heap cell on a device.
pub @tier(embedded)
fn frame_ok(f: CanFrame) -> Bool
    if not canframe.is_frame(f)
        return false
    let id = canframe.frame_id(f)
    var top = canframe.CAN_SFF_MAX_ID
    if canframe.is_extended(f)
        top = canframe.CAN_EFF_MAX_ID
    let n = canframe.frame_len(f)
    id >= 0 and id <= top and n >= 0 and n <= canframe.CAN_MAX_DLEN

// Whether `s` begins with `p`, compared a byte at a time so it builds
// at every tier.
@tier(embedded)
fn prefixed(s: Str, p: Str) -> Bool
    let n = str.len(p)
    if str.len(s) < n
        return false
    for i in 0..n
        if str.byte_at_or(s, i, 0 - 1) != str.byte_at_or(p, i, 0 - 2)
            return false
    true
