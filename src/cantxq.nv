// cantxq.nv — a bounded transmit queue that does not invert the bus's
// own ordering.
//
// A FIFO IS THE WRONG QUEUE FOR CAN, and that is the only reason this
// module exists.  CAN arbitration is by identifier: when two nodes
// start a frame at the same moment the numerically smaller identifier
// wins and the other backs off and retries.  That is a real-time
// guarantee — the highest-priority message on a bus has a bounded
// latency — and a transmit queue that sends in arrival order throws it
// away.  An emergency stop sitting behind six telemetry frames is a
// priority inversion the protocol went to some trouble to prevent, and
// nothing in a FIFO can notice it.
//
// So `dequeue_index` answers the queued frame that WINS ARBITRATION
// rather than the oldest, and `dequeue_fifo_index` is there beside it
// for the caller who really does want arrival order — a logger
// replaying a capture, a test that must be deterministic.  Both are
// named, so a driver's choice is visible at its call site rather than
// implied by which package it picked.
//
// The storage is the caller's.  This module keeps the bookkeeping and
// answers indices into a `Vec[CanFrame; N]` the caller declares, which
// on a device is a module-level `var` in `.bss` sized to the product's
// burst.  A queue that owned its frames would have to allocate.  The
// occupied slots are one run in arrival order; taking a frame from the
// middle moves the oldest frame into the emptied slot (`refill_from`).
//
// The readers `dequeue_index` and the others take, `key_at` and
// `id_at`, read the caller's storage, which is a module-level `var`
// and so costs `[mutate]`; the queue functions that call them are
// charged the same.

use canframe
use canerr

// ── The queue ────────────────────────────────────────────────────────

// A bounded transmit queue: which slots of the caller's array are
// occupied, and in what order they arrived.
//
// The frames themselves are the caller's.  This is four integers.
pub @value
struct CanTxQueue
    // The index of the oldest occupied slot.
    head: Int
    // How many slots are occupied.
    count: Int
    // How many slots the caller's array has.
    capacity: Int
    // How many frames have been dropped since the queue was made,
    // which is the number a health check wants and which a queue that
    // silently dropped would not have.
    dropped: Int

// A queue over a caller's array of `capacity` frames.
//
// ```novo
// use cantxq
//
// fn main() [io]
//     println("${cantxq.capacity(cantxq.queue(16))}")   // 16
// ```
pub @tier(embedded)
fn queue(capacity: Int) -> CanTxQueue []
    var cap = capacity
    if cap < 0
        cap = 0
    CanTxQueue { head: 0, count: 0, capacity: cap, dropped: 0 }

// How many frames are queued.
pub @tier(embedded)
fn len(q: CanTxQueue) -> Int []
    q.count

// How many slots the caller's array has.
pub @tier(embedded)
fn capacity(q: CanTxQueue) -> Int []
    q.capacity

// Whether nothing is queued.
pub @tier(embedded)
fn is_empty(q: CanTxQueue) -> Bool []
    q.count == 0

// Whether every slot is occupied.
pub @tier(embedded)
fn is_full(q: CanTxQueue) -> Bool []
    q.count >= q.capacity

// How many frames have been dropped since the queue was made.
pub @tier(embedded)
fn dropped(q: CanTxQueue) -> Int []
    q.dropped

// ── Putting a frame in ───────────────────────────────────────────────

// Which slot of the caller's array the next frame goes in, or -1 when
// the queue is full.
//
// The caller writes the frame there itself and then calls `enqueued`,
// which is a two-step shape: the bookkeeping is this
// package's and the storage is the caller's, so nothing here ever
// holds a frame.
//
// ```novo
// use cantxq
//
// fn main() [io]
//     println("${cantxq.enqueue_at(cantxq.queue(16))}")   // 0
// ```
pub @tier(embedded)
fn enqueue_at(q: CanTxQueue) -> Int []
    if is_full(q)
        return 0 - 1
    slot(q, q.count)

// The queue after a frame has been written to `enqueue_at`'s slot.
pub @tier(embedded)
fn enqueued(q: CanTxQueue) -> CanTxQueue []
    if is_full(q)
        return q
    CanTxQueue { head: q.head, count: q.count + 1, capacity: q.capacity, dropped: q.dropped }

// The queue with the drop counter raised, for a caller that had no
// room.
//
// Nothing here panics when full: `enqueue_at` answers -1 and the
// caller decides.  That is the right rule
// for a transmit path in an interrupt, where a panic is a reset.
pub @tier(embedded)
fn dropped_one(q: CanTxQueue) -> CanTxQueue []
    CanTxQueue { head: q.head, count: q.count, capacity: q.capacity, dropped: q.dropped + 1 }

// ── Taking one out ───────────────────────────────────────────────────

// Which queued slot holds the frame that wins arbitration against
// every other queued frame, or -1 when the queue is empty.
//
// The function this module exists for.
//
// `key_at` answers the ARBITRATION KEY of the frame in the caller's
// slot `i` — `canframe.arbitration_key`, the one number whose numeric
// order is the bus's own order.  A key rather than a frame for two
// reasons: a `@value` struct cannot appear in a fn value's signature
// (E2015), and a driver that keeps its pending identifiers in a
// parallel array of `Int`s — which a real one does, because that is
// what it programmed into the mailbox registers — never has to
// reconstruct a frame to answer it.
//
// Named rather than a lambda, because a lambda that becomes a value at
// `@tier(embedded)` is refused.
//
// ```novo
// use cantxq
//
// fn main() [io]
//     println("${cantxq.len(cantxq.queue(8))}")   // 0
// ```
pub @tier(embedded)
fn dequeue_index(q: CanTxQueue, key_at: fn(Int) -> Int [mutate]) -> Int [mutate]
    var best = 0 - 1
    var best_key = 0
    for k in 0..q.count
        let i = slot(q, k)
        let key = key_at(i)
        if best < 0 or key < best_key
            best = i
            best_key = key
    best

// Which queued slot holds the OLDEST frame, or -1 when the queue is
// empty.
//
// Arrival order, for the caller who wants it: a logger replaying a
// capture, or a test that must be deterministic regardless of
// identifier.  Named rather than implied, so the choice is visible at
// the call site.
pub @tier(embedded)
fn dequeue_fifo_index(q: CanTxQueue) -> Int []
    if q.count == 0
        return 0 - 1
    q.head

// The slot whose frame the caller moves into slot `i` before calling
// `dequeued(q, i)`, or -1 when nothing moves.
//
// The occupied slots stay one run in arrival order, so taking a frame
// out of the middle frees the oldest slot instead: the oldest frame is
// copied into the slot just emptied, and `dequeued` releases the
// oldest slot.  The copy is the caller's, because the frames are.
// Nothing moves when `i` is the oldest or the newest slot.
//
// ```novo norun:fragment
// let i = cantxq.dequeue_index(q, key_at)
// send(frames[i])
// let from = cantxq.refill_from(q, i)
// if from >= 0
//     frames[i] = frames[from]
// q = cantxq.dequeued(q, i)
// ```
pub @tier(embedded)
fn refill_from(q: CanTxQueue, i: Int) -> Int []
    if q.count < 2 or not occupied(q, i)
        return 0 - 1
    if i == q.head or i == slot(q, q.count - 1)
        return 0 - 1
    q.head

// The queue after the frame in slot `i` has been handed to the
// controller.  When `refill_from(q, i)` named a slot, its frame must
// already have been copied into `i`.
pub @tier(embedded)
fn dequeued(q: CanTxQueue, i: Int) -> CanTxQueue []
    if q.count == 0 or not occupied(q, i)
        return q
    if i == slot(q, q.count - 1) and i != q.head
        return CanTxQueue { head: q.head, count: q.count - 1, capacity: q.capacity, dropped: q.dropped }
    // The slot freed is the oldest: `refill_from` named it, and the
    // caller has moved its frame into `i` already when `i` was not it.
    CanTxQueue { head: slot(q, 1), count: q.count - 1, capacity: q.capacity, dropped: q.dropped }

// The queue with everything discarded, the drop counter raised by
// what was in it.
//
// What a driver does on a bus-off transition: those frames are not
// going anywhere, and a queue that kept them would deliver stale
// commands the moment the bus recovered — which for an actuator is
// worse than delivering nothing.
pub @tier(embedded)
fn cleared(q: CanTxQueue) -> CanTxQueue []
    CanTxQueue { head: 0, count: 0, capacity: q.capacity, dropped: q.dropped + q.count }

// ── Making room ──────────────────────────────────────────────────────

// Which queued slot holds the frame that LOSES arbitration against
// every other queued frame, or -1 when the queue is empty.
//
// The frame to overwrite when a high-priority frame arrives at a full
// queue.  A driver that dropped the NEW frame instead would drop
// exactly the frame that mattered, which is the failure mode of every
// queue that treats fullness as a property of arrival rather than of
// priority.
pub @tier(embedded)
fn lowest_priority_index(q: CanTxQueue, key_at: fn(Int) -> Int [mutate]) -> Int [mutate]
    var worst = 0 - 1
    var worst_key = 0
    for k in 0..q.count
        let i = slot(q, k)
        let key = key_at(i)
        if worst < 0 or key >= worst_key
            worst = i
            worst_key = key
    worst

// Whether a frame with this arbitration key should displace something
// rather than be dropped: true when the queue is full and the key
// beats its lowest-priority member's.
pub @tier(embedded)
fn should_displace(q: CanTxQueue, key: Int, key_at: fn(Int) -> Int [mutate]) -> Bool [mutate]
    if not is_full(q) or q.count == 0
        return false
    key < key_at(lowest_priority_index(q, key_at))

// Whether a frame with this identifier is already queued.
//
// The check a periodic sender needs: a status message sent every 10 ms
// into a queue that is draining slower than that accumulates copies,
// and the newest is the only one worth sending.  `replace_at` is what
// follows.
pub @tier(embedded)
fn holds_id(q: CanTxQueue, id: Int, id_at: fn(Int) -> Int [mutate]) -> Bool [mutate]
    index_of_id(q, id, id_at) >= 0

// Which queued slot holds a frame with this identifier, or -1.
pub @tier(embedded)
fn index_of_id(q: CanTxQueue, id: Int, id_at: fn(Int) -> Int [mutate]) -> Int [mutate]
    for k in 0..q.count
        let i = slot(q, k)
        if id_at(i) == id
            return i
    0 - 1

// Why a frame cannot be queued, or nothing.
pub @tier(rt)
fn check_enqueue(q: CanTxQueue, f: CanFrame) -> ?CanError []
    match canframe.check_frame(f)
        Some(e) =>
            return Some(e)
        None    => ()
    if is_full(q)
        return Some(CanQueueFull(q.capacity))
    None

// The array index of the `k`-th oldest occupied slot.
@tier(embedded)
fn slot(q: CanTxQueue, k: Int) -> Int
    if q.capacity == 0
        return 0
    (q.head + k) % q.capacity

// Whether array index `i` holds a queued frame.
@tier(embedded)
fn occupied(q: CanTxQueue, i: Int) -> Bool
    if i < 0 or i >= q.capacity
        return false
    var k = i - q.head
    if k < 0
        k = k + q.capacity
    k < q.count
