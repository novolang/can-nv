// canisotp.nv — ISO 15765-2: a message longer than eight bytes, over a
// bus whose frames carry eight.
//
// THE PROTOCOL IS FOUR FRAME TYPES AND THREE OF THEM ARE A HANDSHAKE.
// A single frame carries up to seven bytes and is the whole message.
// Anything longer is a first frame, then a FLOW CONTROL frame from the
// receiver saying how many consecutive frames it will take and how
// fast, then consecutive frames numbered 0 to 15 and wrapping.  The
// flow control frame is what makes ISO-TP work on a real bus: a
// diagnostic tool sending 4 KB at bus speed into a microcontroller
// with a 128-byte buffer would overrun it, and `block_size` and
// `st_min` are the receiver saying so before it happens.
//
// THE STATE IS A `@value` STRUCT AND THE BUFFER IS THE CALLER'S.  A
// session's whole state is a message length, a byte offset, a
// four-bit sequence counter, a block counter and two timers' worth of
// deadline — seven integers.  The payload it is assembling is the
// caller's buffer, which on a device is a fixed array in `.bss` sized
// to the largest message that product expects, which is why this
// module builds for a Cortex-M.
//
// TIME IS THE CALLER'S.  A `core` package has no clock, so every
// function that would wait takes `now_ms` and every function that
// would set a timer ANSWERS a deadline.  `deadline_ms` is what the
// caller arms; `timed_out` is the question it asks.  That is also what
// makes the four timers testable as a table rather than as a bus run.
//
// WHAT IS NOT HERE: the addressing modes beyond normal and extended,
// the CAN FD escape that lets a first frame declare a 32-bit length,
// and the 15765-4 diagnostic identifiers.  The first two are named in
// the README as the first things to add; the third is UDS's, not this
// package's.

use canframe
use canerr

// ── The four frame types ─────────────────────────────────────────────

// Protocol control information type 0: the whole message in one frame.
pub const CAN_ISOTP_SINGLE = 0
// Type 1: the first frame of a segmented message, carrying the total
// length.
pub const CAN_ISOTP_FIRST = 1
// Type 2: a consecutive frame, carrying a four-bit sequence number.
pub const CAN_ISOTP_CONSECUTIVE = 2
// Type 3: a flow control frame, which only the receiver sends.
pub const CAN_ISOTP_FLOW = 3

// Flow status: carry on.
pub const CAN_ISOTP_CONTINUE = 0
// Flow status: wait — the receiver is not ready and will send another
// flow control frame.  A sender must honour it or overrun the
// receiver; a sender that sees too many in a row gives up, which is
// what `wait_limit` is for.
pub const CAN_ISOTP_WAIT = 1
// Flow status: overflow — the message is longer than the receiver can
// hold, and the transfer is over.
pub const CAN_ISOTP_OVERFLOW = 2

// The most payload bytes a single frame carries under normal
// addressing: 7.
pub const CAN_ISOTP_SINGLE_MAX = 7
// The most payload bytes a first frame carries: 6.
pub const CAN_ISOTP_FIRST_MAX = 6
// The most payload bytes a consecutive frame carries: 7.
pub const CAN_ISOTP_CONSECUTIVE_MAX = 7
// The longest message a 12-bit first-frame length can declare: 4095.
pub const CAN_ISOTP_MAX_MESSAGE = 4095

// A `block_size` of 0 means "send the whole message without stopping
// for another flow control frame", which is what a host with plenty of
// buffer asks for and what a microcontroller must not.
pub const CAN_ISOTP_NO_BLOCK_LIMIT = 0

// ── Reading a frame's control information ────────────────────────────

// Which of the four types a frame's first payload byte names.
//
// ```novo
// use canisotp
// use canframe
//
// fn main() [io]
//     let f = canframe.frame(0x7E8, 8, canframe.pack2(0x10, 0x14))
//     println("${canisotp.pci_type(f)}")   // 1, a first frame
// ```
pub @tier(embedded)
fn pci_type(f: CanFrame) -> Int []
    if not canframe.is_frame(f) or canframe.frame_len(f) < 1
        return 0 - 1
    let t = canframe.frame_byte(f, 0) >>> 4
    if t > 3
        return 0 - 1
    t

// The payload length a single frame declares, or -1 when the frame is
// not one.
pub @tier(embedded)
fn single_len(f: CanFrame) -> Int []
    if pci_type(f) != CAN_ISOTP_SINGLE
        return 0 - 1
    canframe.frame_byte(f, 0) & 0xF

// The total message length a first frame declares — twelve bits
// across two bytes, which is where the 4095 limit comes from.
//
// ```novo
// use canisotp
// use canframe
//
// fn main() [io]
//     let f = canframe.frame(0x7E8, 8, canframe.pack2(0x10, 0x14))
//     println("${canisotp.first_len(f)}")   // 20
// ```
pub @tier(embedded)
fn first_len(f: CanFrame) -> Int []
    if pci_type(f) != CAN_ISOTP_FIRST
        return 0 - 1
    ((canframe.frame_byte(f, 0) & 0xF) << 8) | canframe.frame_byte(f, 1)

// The four-bit sequence number a consecutive frame carries, or -1.
pub @tier(embedded)
fn consecutive_index(f: CanFrame) -> Int []
    if pci_type(f) != CAN_ISOTP_CONSECUTIVE
        return 0 - 1
    canframe.frame_byte(f, 0) & 0xF

// The flow status a flow control frame carries, or -1.
pub @tier(embedded)
fn flow_status(f: CanFrame) -> Int []
    if pci_type(f) != CAN_ISOTP_FLOW
        return 0 - 1
    canframe.frame_byte(f, 0) & 0xF

// The block size a flow control frame asks for.
pub @tier(embedded)
fn flow_block_size(f: CanFrame) -> Int []
    canframe.frame_byte(f, 1)

// The separation time a flow control frame asks for, in
// MICROSECONDS.
//
// The field is one byte and its encoding is not linear: 0x00 to 0x7F
// are milliseconds, 0xF1 to 0xF9 are 100 to 900 microseconds, and
// everything else is reserved and treated as 127 ms.  A sender that
// read 0xF1 as 241 milliseconds is 2400 times too slow and a sender
// that read it as 241 microseconds is too fast; answering
// microseconds throughout is what stops either.
//
// ```novo
// use canisotp
//
// fn main() [io]
//     println("${canisotp.st_min_us(0xF1)}")   // 100
//     println("${canisotp.st_min_us(10)}")     // 10000
// ```
pub @tier(embedded)
fn st_min_us(encoded: Int) -> Int []
    if encoded >= 0 and encoded <= 0x7F
        return encoded * 1000
    if encoded >= 0xF1 and encoded <= 0xF9
        return (encoded - 0xF0) * 100
    127000

// The one-byte encoding of a separation time given in microseconds,
// rounded up to something the field can express.
pub @tier(embedded)
fn st_min_encode(us: Int) -> Int []
    if us <= 0
        return 0
    if us <= 900
        return 0xF0 + (us + 99) / 100
    let ms = (us + 999) / 1000
    if ms > 0x7F
        return 0x7F
    ms

// ── Building the frames ──────────────────────────────────────────────

// A single frame carrying `len` bytes of the caller's payload.
pub @tier(embedded)
fn single_frame(id: Int, data: Int, len: Int) -> CanFrame []
    var n = len
    if n < 0
        n = 0
    if n > CAN_ISOTP_SINGLE_MAX
        n = CAN_ISOTP_SINGLE_MAX
    canframe.frame(id, n + 1, (n & 0xF) | (low_bytes(data, n) << 8))

// A first frame declaring a total message length and carrying its
// first six bytes.
pub @tier(embedded)
fn first_frame(id: Int, total_len: Int, data: Int) -> CanFrame []
    let b0 = 0x10 | ((total_len >>> 8) & 0xF)
    let b1 = total_len & 0xFF
    canframe.frame(id, 8, b0 | (b1 << 8) | (low_bytes(data, CAN_ISOTP_FIRST_MAX) << 16))

// A consecutive frame with sequence number `index` and up to seven
// bytes.
//
// The sequence number wraps at 16 and STARTS AT 1, not 0 — the first
// frame is implicitly 0, so a sender that numbered its first
// consecutive frame 0 has its whole message rejected by a conforming
// receiver.
pub @tier(embedded)
fn consecutive_frame(id: Int, index: Int, data: Int, len: Int) -> CanFrame []
    var n = len
    if n < 0
        n = 0
    if n > CAN_ISOTP_CONSECUTIVE_MAX
        n = CAN_ISOTP_CONSECUTIVE_MAX
    canframe.frame(id, n + 1, 0x20 | (index & 0xF) | (low_bytes(data, n) << 8))

// A flow control frame.
//
// ```novo
// use canisotp
// use canframe
//
// fn main() [io]
//     let f = canisotp.flow_frame(0x7E0, canisotp.CAN_ISOTP_CONTINUE, 8, 0xF1)
//     println("${canframe.frame_byte(f, 1)}")   // 8, the block size
// ```
pub @tier(embedded)
fn flow_frame(id: Int, status: Int, block_size: Int, st_min: Int) -> CanFrame []
    canframe.frame(id, 3, canframe.pack4(0x30 | (status & 0xF), block_size, st_min, 0))

// The next sequence number after `index`, wrapping 15 to 0.
pub @tier(embedded)
fn next_index(index: Int) -> Int []
    (index + 1) & 0xF

// How many consecutive frames a message of `len` bytes needs after its
// first frame.
//
// ```novo
// use canisotp
//
// fn main() [io]
//     println("${canisotp.consecutive_count(20)}")   // 2
// ```
pub @tier(embedded)
fn consecutive_count(len: Int) -> Int []
    if len <= CAN_ISOTP_SINGLE_MAX
        return 0
    (len - CAN_ISOTP_FIRST_MAX + CAN_ISOTP_CONSECUTIVE_MAX - 1) / CAN_ISOTP_CONSECUTIVE_MAX

// ── The session ──────────────────────────────────────────────────────

// A transfer in progress, in either direction.
//
// Seven integers, and the payload buffer is the caller's.  The same
// type serves a send and a receive, because the two are the same state
// machine seen from different ends and a caller that ran both would
// otherwise hold two.
pub @value
struct CanIsoTpSession
    // One of the `CAN_ISOTP_STATE_*` codes.
    state: Int
    // The total message length, from a first frame or from the
    // caller.
    total: Int
    // How many bytes have crossed so far.
    done: Int
    // The next sequence number expected or to be sent.
    index: Int
    // How many frames are left in this block before a flow control
    // frame is due.  Zero with an unlimited block size means "never".
    block_left: Int
    // The separation time in force, in microseconds.
    st_min_us: Int
    // How many consecutive WAIT flow control frames have arrived,
    // which is the counter that stops a stalled transfer from being
    // forever.
    waits: Int

// Idle: nothing in progress.
pub const CAN_ISOTP_STATE_IDLE = 0
// Sending, and waiting for a flow control frame before the next
// block.
pub const CAN_ISOTP_STATE_WAIT_FLOW = 1
// Sending consecutive frames.
pub const CAN_ISOTP_STATE_SENDING = 2
// Receiving consecutive frames.
pub const CAN_ISOTP_STATE_RECEIVING = 3
// The transfer finished.
pub const CAN_ISOTP_STATE_DONE = 4
// The transfer failed.  `session_fault` says why.
pub const CAN_ISOTP_STATE_FAILED = 5

// A session in the idle state.
//
// ```novo
// use canisotp
//
// fn main() [io]
//     println("${canisotp.session_state(canisotp.session())}")   // 0
// ```
pub @tier(embedded)
fn session() -> CanIsoTpSession []
    CanIsoTpSession { state: CAN_ISOTP_STATE_IDLE,
        total: 0,
        done: 0,
        index: 0,
        block_left: 0,
        st_min_us: 0,
        waits: 0 }

// Begin sending a message of `total` bytes.
pub @tier(embedded)
fn begin_send(s: CanIsoTpSession, total: Int) -> CanIsoTpSession []
    if total < 0 or total > CAN_ISOTP_MAX_MESSAGE
        return failed(s, FAIL_TOO_LONG, total)
    if total <= CAN_ISOTP_SINGLE_MAX
        return CanIsoTpSession { state: CAN_ISOTP_STATE_DONE,
            total: total,
            done: total,
            index: 0,
            block_left: 0,
            st_min_us: 0,
            waits: 0 }
    CanIsoTpSession { state: CAN_ISOTP_STATE_WAIT_FLOW,
        total: total,
        done: CAN_ISOTP_FIRST_MAX,
        index: 1,
        block_left: 0,
        st_min_us: 0,
        waits: 0 }

// Take a flow control frame while sending: adopt its block size and
// separation time, or fail on an overflow, or count a wait.
pub @tier(embedded)
fn take_flow(s: CanIsoTpSession, f: CanFrame) -> CanIsoTpSession []
    if s.state != CAN_ISOTP_STATE_WAIT_FLOW
        return s
    let st = flow_status(f)
    if st == CAN_ISOTP_CONTINUE
        var left = flow_block_size(f)
        if left == CAN_ISOTP_NO_BLOCK_LIMIT
            left = UNLIMITED
        return CanIsoTpSession { state: CAN_ISOTP_STATE_SENDING,
            total: s.total,
            done: s.done,
            index: s.index,
            block_left: left,
            st_min_us: st_min_us(canframe.frame_byte(f, 2)),
            waits: 0 }
    if st == CAN_ISOTP_WAIT
        if s.waits + 1 > CAN_ISOTP_MAX_WAITS
            return failed(s, FAIL_WAITS, s.waits + 1)
        return CanIsoTpSession { state: s.state,
            total: s.total,
            done: s.done,
            index: s.index,
            block_left: s.block_left,
            st_min_us: s.st_min_us,
            waits: s.waits + 1 }
    failed(s, FAIL_OVERFLOW, 0)

// Account for a consecutive frame just sent.
pub @tier(embedded)
fn sent_consecutive(s: CanIsoTpSession, len: Int) -> CanIsoTpSession []
    if s.state != CAN_ISOTP_STATE_SENDING
        return s
    let done = s.done + len
    if done >= s.total
        return CanIsoTpSession { state: CAN_ISOTP_STATE_DONE,
            total: s.total,
            done: s.total,
            index: next_index(s.index),
            block_left: 0,
            st_min_us: s.st_min_us,
            waits: 0 }
    var left = s.block_left
    var state = s.state
    if left != UNLIMITED
        left = left - 1
        if left <= 0
            left = 0
            state = CAN_ISOTP_STATE_WAIT_FLOW
    CanIsoTpSession { state: state,
        total: s.total,
        done: done,
        index: next_index(s.index),
        block_left: left,
        st_min_us: s.st_min_us,
        waits: 0 }

// Begin receiving, from a first frame, into a buffer of `capacity`
// bytes.
//
// A capacity smaller than the declared length is what
// `CAN_ISOTP_OVERFLOW` exists for, and `should_send_overflow` is the
// question a receiver asks before it answers.
pub @tier(embedded)
fn begin_receive(s: CanIsoTpSession, f: CanFrame, capacity: Int) -> CanIsoTpSession []
    if pci_type(f) != CAN_ISOTP_FIRST
        return failed(s, FAIL_SEQUENCE, 0)
    let total = first_len(f)
    if should_send_overflow(total, capacity)
        return failed(CanIsoTpSession { state: s.state,
            total: total,
            done: 0,
            index: 0,
            block_left: 0,
            st_min_us: 0,
            waits: 0 },
        FAIL_TOO_LONG, capacity)
    var done = CAN_ISOTP_FIRST_MAX
    if done > total
        done = total
    CanIsoTpSession { state: CAN_ISOTP_STATE_RECEIVING,
        total: total,
        done: done,
        index: 1,
        block_left: 0,
        st_min_us: 0,
        waits: 0 }

// Take a consecutive frame while receiving.
//
// A frame whose sequence number is not the expected one FAILS the
// transfer rather than being skipped, because ISO-TP has no
// retransmission: a gap means a frame was lost and the message cannot
// be reassembled, and a receiver that carried on would hand its caller
// a message with a hole in it.
pub @tier(embedded)
fn take_consecutive(s: CanIsoTpSession, f: CanFrame) -> CanIsoTpSession []
    if s.state != CAN_ISOTP_STATE_RECEIVING
        return s
    let got = consecutive_index(f)
    if got != s.index
        return failed(s, FAIL_SEQUENCE, got)
    var n = s.total - s.done
    if n > CAN_ISOTP_CONSECUTIVE_MAX
        n = CAN_ISOTP_CONSECUTIVE_MAX
    let done = s.done + n
    var state = s.state
    if done >= s.total
        state = CAN_ISOTP_STATE_DONE
    CanIsoTpSession { state: state,
        total: s.total,
        done: done,
        index: next_index(s.index),
        block_left: 0,
        st_min_us: 0,
        waits: 0 }

// Whether a flow control frame is due now.
pub @tier(embedded)
fn flow_due(s: CanIsoTpSession) -> Bool []
    s.state == CAN_ISOTP_STATE_WAIT_FLOW

// Whether a receiver should answer OVERFLOW rather than CONTINUE for a
// message of `total` bytes into a buffer of `capacity`.
pub @tier(embedded)
fn should_send_overflow(total: Int, capacity: Int) -> Bool []
    total > capacity

// The session's state code.
pub @tier(embedded)
fn session_state(s: CanIsoTpSession) -> Int []
    s.state

// The declared total length.
pub @tier(embedded)
fn session_total(s: CanIsoTpSession) -> Int []
    s.total

// How many bytes have crossed.
pub @tier(embedded)
fn session_done(s: CanIsoTpSession) -> Int []
    s.done

// The next sequence number.
pub @tier(embedded)
fn session_index(s: CanIsoTpSession) -> Int []
    s.index

// The separation time in force, in microseconds.
pub @tier(embedded)
fn session_st_min_us(s: CanIsoTpSession) -> Int []
    s.st_min_us

// How many frames remain in this block.
pub @tier(embedded)
fn session_block_left(s: CanIsoTpSession) -> Int []
    if s.block_left == UNLIMITED or s.state == CAN_ISOTP_STATE_FAILED
        return 0
    s.block_left

// How many consecutive WAIT frames have arrived.
pub @tier(embedded)
fn session_waits(s: CanIsoTpSession) -> Int []
    s.waits

// Whether the transfer is over, either way.
pub @tier(embedded)
fn session_is_finished(s: CanIsoTpSession) -> Bool []
    s.state == CAN_ISOTP_STATE_DONE or s.state == CAN_ISOTP_STATE_FAILED

// Why a failed session failed, or nothing.
//
// A `@value` struct cannot be a `Result` payload (SPEC § 14.5), so the
// session carries a state code and this answers the reason beside it.
pub @tier(rt)
fn session_fault(s: CanIsoTpSession) -> ?CanError []
    if s.state != CAN_ISOTP_STATE_FAILED
        return None
    let why = s.block_left
    if why == FAIL_SEQUENCE
        return Some(CanIsoTpBadSequence(s.index, s.st_min_us))
    if why == FAIL_TOO_LONG
        return Some(CanIsoTpTooLong(s.total, s.st_min_us))
    if why == FAIL_OVERFLOW
        return Some(CanIsoTpOverflow)
    if why == FAIL_N_AS
        return Some(CanIsoTpTimeout("N_As"))
    if why == FAIL_N_BS
        return Some(CanIsoTpTimeout("N_Bs"))
    if why == FAIL_N_CR
        return Some(CanIsoTpTimeout("N_Cr"))
    Some(CanIsoTpTimeout("N_Bs"))

// ── The four timers, as deadlines the caller arms ────────────────────

// N_As: how long a sender waits for a frame it queued to reach the
// bus.  1000 ms.
pub const CAN_ISOTP_N_AS_MS = 1000
// N_Bs: how long a sender waits for a flow control frame.  1000 ms.
pub const CAN_ISOTP_N_BS_MS = 1000
// N_Cr: how long a receiver waits for the next consecutive frame.
// 1000 ms.
pub const CAN_ISOTP_N_CR_MS = 1000
// How many consecutive WAIT flow control frames a sender tolerates
// before it gives up.  The specification leaves this to the
// implementation and every implementation picks a number; this one is
// the common one.
pub const CAN_ISOTP_MAX_WAITS = 10

// The deadline the session's current state wants armed, given the
// clock the caller read.
//
// A `core` package has no clock, so this ANSWERS a moment rather than
// waiting for one.  Which of the three timers it is depends on the
// state, which is why it is one function rather than three constants
// the caller has to choose between correctly.
//
// ```novo
// use canisotp
//
// fn main() [io]
//     println("${canisotp.deadline_ms(canisotp.session(), 0)}")
// ```
pub @tier(embedded)
fn deadline_ms(s: CanIsoTpSession, now_ms: Int) -> Int []
    if s.state == CAN_ISOTP_STATE_WAIT_FLOW
        return now_ms + CAN_ISOTP_N_BS_MS
    if s.state == CAN_ISOTP_STATE_RECEIVING
        return now_ms + CAN_ISOTP_N_CR_MS
    if s.state == CAN_ISOTP_STATE_SENDING
        return now_ms + CAN_ISOTP_N_AS_MS
    0 - 1

// Whether the session's deadline has passed.
pub @tier(embedded)
fn timed_out(s: CanIsoTpSession, armed_at_ms: Int, now_ms: Int) -> Bool []
    let dl = deadline_ms(s, armed_at_ms)
    dl >= 0 and now_ms > dl

// The session moved to failed, with the timer that expired named.
pub @tier(embedded)
fn on_timeout(s: CanIsoTpSession) -> CanIsoTpSession []
    if s.state == CAN_ISOTP_STATE_WAIT_FLOW
        return failed(s, FAIL_N_BS, 0)
    if s.state == CAN_ISOTP_STATE_RECEIVING
        return failed(s, FAIL_N_CR, 0)
    if s.state == CAN_ISOTP_STATE_SENDING
        return failed(s, FAIL_N_AS, 0)
    s

// ── Extended addressing ──────────────────────────────────────────────

// Under extended addressing the first payload byte is an address and
// everything else shifts down one, so a single frame carries six bytes
// rather than seven.
//
// A whole second set of length constants would be four more names to
// get wrong; one function that says how much room the addressing mode
// costs is the same fact once.
//
// ```novo
// use canisotp
//
// fn main() [io]
//     println("${canisotp.addressing_overhead(true)}")   // 1
// ```
pub @tier(embedded)
fn addressing_overhead(extended_addressing: Bool) -> Int []
    if extended_addressing
        return 1
    0

// The most bytes a single frame carries under this addressing mode.
pub @tier(embedded)
fn single_max(extended_addressing: Bool) -> Int []
    CAN_ISOTP_SINGLE_MAX - addressing_overhead(extended_addressing)

// The most bytes a consecutive frame carries under this addressing
// mode.
pub @tier(embedded)
fn consecutive_max(extended_addressing: Bool) -> Int []
    CAN_ISOTP_CONSECUTIVE_MAX - addressing_overhead(extended_addressing)

// ── Inside the session ───────────────────────────────────────────────

// `block_left` while a sender may send without waiting for another flow
// control frame: the receiver asked for a block size of 0.
const UNLIMITED = 0 - 1

// Why a session failed.  A failed session keeps the reason in
// `block_left` and the number that decided it in `st_min_us`, so the
// session stays seven integers and `session_fault` can name both.
const FAIL_SEQUENCE = 1
const FAIL_TOO_LONG = 2
const FAIL_OVERFLOW = 3
const FAIL_N_AS = 4
const FAIL_N_BS = 5
const FAIL_N_CR = 6
const FAIL_WAITS = 7

// The session moved to failed for `why`, with `detail`.
@tier(embedded)
fn failed(s: CanIsoTpSession, why: Int, detail: Int) -> CanIsoTpSession
    CanIsoTpSession { state: CAN_ISOTP_STATE_FAILED,
        total: s.total,
        done: s.done,
        index: s.index,
        block_left: why,
        st_min_us: detail,
        waits: s.waits }

// The low `n` bytes of a packed payload word, the rest cleared.  `n`
// is at most 7, the bytes a frame carries after its protocol byte,
// which is what every caller passes.
@tier(embedded)
fn low_bytes(data: Int, n: Int) -> Int
    if n <= 0
        return 0
    data & ((1 << (8 * n)) - 1)
