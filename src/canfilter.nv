// canfilter.nv — acceptance filters and masks, as values.
//
// A FILTER IS A CONTROLLER'S ONLY DEFENCE.  A busy CAN bus carries
// thousands of frames a second and a node cares about perhaps five of
// them; a controller that interrupted on all of them would spend its
// life in an interrupt handler.  Every CAN peripheral therefore has
// hardware acceptance filters, and this module is the arithmetic for
// deciding what to program into them and for deciding the same thing
// in software when there are more filters than the hardware has.
//
// THE SAME VALUE PROGRAMS A REGISTER AND ANSWERS A QUESTION.  `accepts`
// is the software evaluation of exactly what the hardware does — mask
// the identifier, compare — so a filter that is programmed into a
// peripheral and a filter that is evaluated in a receive callback
// cannot disagree.  A driver with four hardware slots and nine filters
// programs a WIDENED filter into the hardware (`merge`) and evaluates
// the precise ones in software, which is the only correct way to do it
// and is impossible to write without both halves in one place.
//
// A `@value` STRUCT OF THREE INTEGERS, so a filter table is an array
// in a `.bss` section and costs nothing to hold.
//
// AN UNREACHABLE FILTER IS REFUSED.  A filter whose identifier has
// bits its mask does not cover can never match: the comparison masks
// both sides, so those bits are ignored and the filter accepts more
// than its author wrote — or, with `inverted` set, rejects more.  It
// is the single hardest CAN fault to find, because nothing anywhere
// reports it and the symptom is frames that do not arrive.
// `check_filter` is the refusal.

use canframe
use canerr

// ── The filter ───────────────────────────────────────────────────────

// One acceptance filter: an identifier, a mask over it, and flags.
//
// A bit set in `mask` is a bit that must MATCH.  A mask of 0 accepts
// everything, and a mask of `CAN_SFF_MASK` accepts exactly one
// standard identifier.
pub @value
struct CanFilter
    // The identifier to compare against, already masked.
    id: Int
    // Which bits of the identifier must match.
    mask: Int
    // `CAN_FILTER_*` bits.
    flags: Int

// The filter matches extended (29-bit) identifiers rather than
// standard ones.
pub const CAN_FILTER_EXTENDED = 0x01
// The filter's sense is inverted: a frame that matches is REJECTED.
// SocketCAN's `CAN_INV_FILTER`, and the shape a caller wants for "I
// want everything except the diagnostic traffic".
pub const CAN_FILTER_INVERTED = 0x02
// The filter also matches remote transmission requests.  Off by
// default, because a node that answers its own remote frames is a
// surprise a caller should ask for.
pub const CAN_FILTER_ALLOW_RTR = 0x04
// The filter is a LIST of two identifiers rather than an identifier and
// a mask: it matches exactly those two.  `id` holds the first and
// `mask` the second.  A controller holds one in a filter slot in its
// list mode (a bxCAN bank in identifier-list mode, an M_CAN dual-ID
// element), which is two exact matches for the price of one slot.
pub const CAN_FILTER_LIST = 0x08

// Build a filter over standard identifiers.
//
// ```novo
// use canfilter
//
// fn main() [io]
//     let f = canfilter.filter(0x100, 0x700)
//     println("${canfilter.accepts_id(f, 0x123, false)}")   // true
// ```
pub @tier(embedded)
fn filter(id: Int, mask: Int) -> CanFilter []
    CanFilter { id: id, mask: mask, flags: 0 }

// Build a filter over extended identifiers.
pub @tier(embedded)
fn filter_ext(id: Int, mask: Int) -> CanFilter []
    CanFilter { id: id, mask: mask, flags: CAN_FILTER_EXTENDED }

// A filter that accepts exactly one standard identifier.
//
// ```novo
// use canfilter
//
// fn main() [io]
//     println("${canfilter.filter_mask(canfilter.exact(0x123))}")   // 2047
// ```
pub @tier(embedded)
fn exact(id: Int) -> CanFilter []
    filter(id, CAN_SFF_MASK)

// A filter that accepts exactly one extended identifier.
pub @tier(embedded)
fn exact_ext(id: Int) -> CanFilter []
    filter_ext(id, CAN_EFF_MASK)

// A filter that accepts every standard identifier.
pub @tier(embedded)
fn accept_all() -> CanFilter []
    filter(0, 0)

// A filter that accepts every extended identifier.
pub @tier(embedded)
fn accept_all_ext() -> CanFilter []
    filter_ext(0, 0)

// A list filter over standard identifiers: exactly `id_a` and `id_b`.
//
// ```novo
// use canfilter
//
// fn main() [io]
//     let f = canfilter.list(0x100, 0x2A0)
//     println("${canfilter.accepts_id(f, 0x2A0, false)} ${canfilter.width(f)}")   // true 2
// ```
pub @tier(embedded)
fn list(id_a: Int, id_b: Int) -> CanFilter []
    CanFilter { id: id_a, mask: id_b, flags: CAN_FILTER_LIST }

// A list filter over extended identifiers.
pub @tier(embedded)
fn list_ext(id_a: Int, id_b: Int) -> CanFilter []
    CanFilter { id: id_a, mask: id_b, flags: CAN_FILTER_LIST | CAN_FILTER_EXTENDED }

// Whether the filter is a list of two identifiers.
pub @tier(embedded)
fn filter_is_list(f: CanFilter) -> Bool []
    (f.flags & CAN_FILTER_LIST) != 0

// The same filter with its sense inverted: what it accepted it now
// rejects.
pub @tier(embedded)
fn inverted(f: CanFilter) -> CanFilter []
    CanFilter { id: f.id, mask: f.mask, flags: f.flags ^ CAN_FILTER_INVERTED }

// The same filter, also accepting remote frames.
pub @tier(embedded)
fn allowing_remote(f: CanFilter) -> CanFilter []
    CanFilter { id: f.id, mask: f.mask, flags: f.flags | CAN_FILTER_ALLOW_RTR }

// The identifier.
pub @tier(embedded)
fn filter_id(f: CanFilter) -> Int []
    f.id

// The mask.
pub @tier(embedded)
fn filter_mask(f: CanFilter) -> Int []
    f.mask

// The flag bits.
pub @tier(embedded)
fn filter_flags(f: CanFilter) -> Int []
    f.flags

// Whether the filter is over extended identifiers.
pub @tier(embedded)
fn filter_is_extended(f: CanFilter) -> Bool []
    (f.flags & CAN_FILTER_EXTENDED) != 0

// Whether the filter's sense is inverted.
pub @tier(embedded)
fn filter_is_inverted(f: CanFilter) -> Bool []
    (f.flags & CAN_FILTER_INVERTED) != 0

// ── Evaluating one ───────────────────────────────────────────────────

// Whether the filter accepts a frame with this identifier and format.
//
// The exact arithmetic a peripheral's acceptance hardware does, so a
// filter evaluated here and the same filter programmed into a
// controller cannot disagree.  A filter over extended identifiers
// never accepts a standard frame and the other way round, which is a
// separate check from the mask and the one a caller forgets.
//
// ```novo
// use canfilter
//
// fn main() [io]
//     let f = canfilter.filter(0x100, 0x700)
//     println("${canfilter.accepts_id(f, 0x1FF, false)}")   // true
//     println("${canfilter.accepts_id(f, 0x2FF, false)}")   // false
// ```
pub @tier(embedded)
fn accepts_id(f: CanFilter, id: Int, extended: Bool) -> Bool []
    if extended != filter_is_extended(f)
        return false
    let m = matches(f, id)
    if filter_is_inverted(f)
        return not m
    m

// Whether the filter accepts this frame, its remote flag included.
pub @tier(embedded)
fn accepts(f: CanFilter, fr: CanFrame) -> Bool []
    if not canframe.is_frame(fr)
        return false
    if canframe.is_remote(fr) and (f.flags & CAN_FILTER_ALLOW_RTR) == 0
        return false
    accepts_id(f, canframe.frame_id(fr), canframe.is_extended(fr))

// How many identifiers the filter accepts.
//
// The number that says whether a filter is doing its job: 1 is an
// exact match, 2048 is every standard identifier, and a filter that a
// caller believed was narrow answering 512 is the bug found before it
// reaches a bus.
//
// ```novo
// use canfilter
//
// fn main() [io]
//     println("${canfilter.width(canfilter.filter(0x100, 0x700))}")   // 256
// ```
pub @tier(embedded)
fn width(f: CanFilter) -> Int []
    let n = match_width(f)
    if filter_is_inverted(f)
        return space(f) - n
    n

// Why a filter cannot be used, or nothing.
//
// An identifier with bits outside its mask is the one that matters:
// the comparison masks both sides, so those bits change nothing and
// the filter accepts more than its author wrote.  Nothing anywhere
// reports it, and the symptom is frames that do not arrive.
//
// ```novo
// use canfilter
//
// fn main() [io]
//     println("${canfilter.filter_id(canfilter.filter(0x123, 0x700))}")
// ```
pub @tier(rt)
fn check_filter(f: CanFilter) -> ?CanError []
    let fm = format_mask(f)
    if filter_is_list(f)
        if (f.id & ~fm) != 0 or (f.mask & ~fm) != 0
            return Some(CanFilterUnreachable(f.id, f.mask))
        return None
    if (f.id & ~f.mask & fm) != 0 or (f.id & ~fm) != 0
        return Some(CanFilterUnreachable(f.id, f.mask))
    None

// ── Fitting more filters than the hardware has ───────────────────────

// The narrowest single filter that accepts everything both of these
// do, and possibly more.
//
// The function a driver with four hardware slots and nine filters
// needs.  What it answers is a WIDENING — it never rejects a frame
// either input would have accepted — so the hardware filter is safe to
// program and the precise ones are evaluated in software afterwards.
// `false_accept_width` says how much was given away.
//
// Two filters of different identifier formats cannot be merged, and
// the answer is then `accept_all` of neither — `can_merge` is the
// question to ask first.
//
// ```novo
// use canfilter
//
// fn main() [io]
//     let m = canfilter.merge(canfilter.exact(0x100), canfilter.exact(0x101))
//     println("${canfilter.width(m)}")   // 2
// ```
pub @tier(embedded)
fn merge(a: CanFilter, b: CanFilter) -> CanFilter []
    if filter_is_list(a) or filter_is_list(b)
        if filter_is_inverted(a) or not can_merge(a, b)
            if filter_is_extended(a)
                return accept_all_ext()
            return accept_all()
        return merge(as_mask(a), as_mask(b))
    if not can_merge(a, b)
        if filter_is_extended(a)
            return accept_all_ext()
        return accept_all()
    let fm = format_mask(a)
    if filter_is_inverted(a)
        // The match sets' intersection, inverted: what either input
        // rejects is still rejected only where both reject it.
        if not match_overlaps(a, b)
            return CanFilter { id: 0, mask: 0, flags: a.flags & ~CAN_FILTER_INVERTED }
        let m = (a.mask | b.mask) & fm
        return CanFilter { id: ((a.id & a.mask) | (b.id & b.mask)) & m,
            mask: m,
            flags: a.flags | (b.flags & CAN_FILTER_ALLOW_RTR) }
    let m = a.mask & b.mask & ~(a.id ^ b.id) & fm
    CanFilter { id: a.id & m, mask: m, flags: a.flags | (b.flags & CAN_FILTER_ALLOW_RTR) }

// Whether two filters can be merged at all: same identifier format,
// same sense.
pub @tier(embedded)
fn can_merge(a: CanFilter, b: CanFilter) -> Bool []
    filter_is_extended(a) == filter_is_extended(b) and filter_is_inverted(a) == filter_is_inverted(b)

// How many identifiers the merge of these two accepts that neither of
// them did.
//
// The cost of the widening, as a number a driver can compare against a
// budget: a merge that lets through 4096 extra identifiers on a bus
// carrying 200 is a merge that has switched the filter off.
pub @tier(embedded)
fn false_accept_width(a: CanFilter, b: CanFilter) -> Int []
    let m = merge(a, b)
    let either = width(a) + width(b) - both_width(a, b)
    let extra = width(m) - either
    if extra < 0
        return 0
    extra

// Whether `a` accepts everything `b` does, so `b` adds nothing beside
// it.
//
// The check that finds a redundant filter, which is the other half of
// fitting nine filters into four slots: two of the nine are usually
// the same filter written twice.
pub @tier(embedded)
fn covers(a: CanFilter, b: CanFilter) -> Bool []
    if filter_is_extended(a) != filter_is_extended(b)
        return width(b) == 0
    if (b.flags & CAN_FILTER_ALLOW_RTR) != 0 and (a.flags & CAN_FILTER_ALLOW_RTR) == 0
        return false
    let ia = filter_is_inverted(a)
    let ib = filter_is_inverted(b)
    if not ia and not ib
        return match_covers(a, b)
    if ia and ib
        return match_covers(b, a)
    if ia
        return not match_overlaps(a, b)
    // `a` matches, `b` accepts the complement of what it matches: only
    // a filter matching everything covers that.
    match_width(a) == space(a)

// Whether any identifier is accepted by both.
pub @tier(embedded)
fn overlaps(a: CanFilter, b: CanFilter) -> Bool []
    if filter_is_extended(a) != filter_is_extended(b)
        return false
    both_width(a, b) > 0

// ── Set arithmetic over one identifier format ────────────────────────

// The identifier bits of the filter's format: eleven or twenty-nine.
@tier(embedded)
fn format_mask(f: CanFilter) -> Int
    if filter_is_extended(f)
        return canframe.CAN_EFF_MASK
    canframe.CAN_SFF_MASK

// How many identifiers the format has: 2048 or 2^29.
@tier(embedded)
fn space(f: CanFilter) -> Int
    format_mask(f) + 1

// Whether the identifier matches the filter's identifier under its mask,
// before the inversion is applied.
@tier(embedded)
fn matches(f: CanFilter, id: Int) -> Bool
    let fm = format_mask(f)
    if filter_is_list(f)
        return (id & fm) == (f.id & fm) or (id & fm) == (f.mask & fm)
    ((id ^ f.id) & f.mask & fm) == 0

// The number of bits set.
@tier(embedded)
fn ones(v: Int) -> Int
    var n = 0
    for i in 0..64
        n = n + ((v >>> i) & 1)
    n

// How many identifiers the filter matches, before the inversion.
@tier(embedded)
fn match_width(f: CanFilter) -> Int
    let fm = format_mask(f)
    if filter_is_list(f)
        if (f.id & fm) == (f.mask & fm)
            return 1
        return 2
    1 << (ones(fm) - ones(f.mask & fm))

// Whether some identifier matches both, before the inversions.
@tier(embedded)
fn match_overlaps(a: CanFilter, b: CanFilter) -> Bool
    if filter_is_list(a) or filter_is_list(b)
        return match_both(a, b) > 0
    ((a.id ^ b.id) & a.mask & b.mask & format_mask(a)) == 0

// How many identifiers match both, before the inversions.
@tier(embedded)
fn match_both(a: CanFilter, b: CanFilter) -> Int
    if filter_is_list(a)
        var n = 0
        if matches(b, a.id)
            n = n + 1
        if match_width(a) == 2 and matches(b, a.mask)
            n = n + 1
        return n
    if filter_is_list(b)
        return match_both(b, a)
    if not match_overlaps(a, b)
        return 0
    let fm = format_mask(a)
    1 << (ones(fm) - ones((a.mask | b.mask) & fm))

// Whether every identifier `b` matches is one `a` matches.
@tier(embedded)
fn match_covers(a: CanFilter, b: CanFilter) -> Bool
    if filter_is_list(a) or filter_is_list(b)
        return match_both(a, b) == match_width(b)
    let fm = format_mask(a)
    let am = a.mask & fm
    (am & ~(b.mask & fm)) == 0 and ((a.id ^ b.id) & am) == 0

// How many identifiers both filters accept, inversions included.  Two
// filters of different formats share none.
@tier(embedded)
fn both_width(a: CanFilter, b: CanFilter) -> Int
    if filter_is_extended(a) != filter_is_extended(b)
        return 0
    let ma = match_width(a)
    let mb = match_width(b)
    let mi = match_both(a, b)
    let ia = filter_is_inverted(a)
    let ib = filter_is_inverted(b)
    if not ia and not ib
        return mi
    if ia and ib
        return space(a) - (ma + mb - mi)
    if ia
        return mb - mi
    ma - mi

// A list filter widened to the mask filter that matches both of its
// identifiers; any other filter unchanged.
@tier(embedded)
fn as_mask(f: CanFilter) -> CanFilter
    if not filter_is_list(f)
        return f
    let fm = format_mask(f)
    let m = ~(f.id ^ f.mask) & fm
    CanFilter { id: f.id & m, mask: m, flags: f.flags & ~CAN_FILTER_LIST }
