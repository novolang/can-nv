// canboard_bus_tests.nv — canboard's generic functions over a
// controller that is a value in the test: open and refuse, transmit
// gates, receive, the counters and bus-off.

use std.test
use embedded_hal.{ CanBus, CanBusFrame, CanBusErrors }
use canframe
use canbus
use canhal
use canboard
use canerr

// A controller whose answers are fields.
struct FakeCan
    opens: Bool
    sends: Bool
    has_rx: Bool
    done: Bool
    tx: Int
    rx: Int
    state: Int

impl CanBus for FakeCan
    fn open(self, bitrate: Int, mode: Int) -> Bool [hw]
        self.opens

    fn send(self, f: CanBusFrame) -> Bool [hw]
        self.sends

    fn receive(self) -> ?CanBusFrame [hw]
        if self.has_rx
            return Some(embedded_hal.can_data(0x123, 1, 0x7F))
        None

    fn tx_done(self) -> Bool [hw]
        self.done

    fn bitrate(self) -> Int [hw]
        500000

    fn errors(self) -> CanBusErrors [hw]
        CanBusErrors { tx: self.tx, rx: self.rx, state: self.state }

fn fake() -> FakeCan
    FakeCan { opens: true, sends: true, has_rx: true, done: true, tx: 0, rx: 0, state: 0 }

fn fake_with(opens: Bool, sends: Bool, has_rx: Bool, done: Bool, tx: Int, rx: Int,
             state: Int) -> FakeCan
    FakeCan { opens: opens, sends: sends, has_rx: has_rx, done: done, tx: tx, rx: rx, state: state }

@test
fn test_opening_starts_or_leaves_the_board_unstarted() [io, hw]
    test.case("a controller that accepts the rate and mode is started under its id, in loop-back or normal mode; one that refuses is not")
    let a = canboard.open_on(fake(), 3, 500000, false)
    test.assert(canboard.board_started(a))
    let b = canboard.open_on(fake(), 3, 500000, true)
    test.assert(canboard.board_started(b))
    let refusing = fake_with(false, true, true, true, 0, 0, 0)
    let c = canboard.open_on(refusing, 3, 500000, false)
    test.assert(canboard.board_started(c) == false)

@test
fn test_a_transmit_is_gated_by_frame_state_then_bus_then_mailbox() [io, hw]
    test.case("a bad frame is refused, a bus-off controller is refused, a busy mailbox reads as full, and a free one takes the frame into mailbox 0")
    let f = canframe.frame(0x123, 1, 7)
    let ok = canboard.bus_transmit(fake(), f)
    test.assert(canhal.tx_ok(ok))
    test.assert_eq(canhal.accepted_mailbox(ok), 0)
    test.assert_eq(canhal.tx_status(canboard.bus_transmit(fake(), canframe.frame(0x800, 1, 7))),
        canhal.CAN_TX_REFUSED)
    let off = fake_with(true, true, true, true, 0, 0, 2)
    test.assert_eq(canhal.tx_status(canboard.bus_transmit(off, f)), canhal.CAN_TX_BUS_OFF)
    let busy = fake_with(true, false, true, true, 0, 0, 0)
    test.assert_eq(canhal.tx_status(canboard.bus_transmit(busy, f)), canhal.CAN_TX_FULL)

@test
fn test_a_mailbox_is_done_when_the_controller_says_so() [io, hw]
    test.case("only mailbox 0 exists")
    test.assert(canboard.bus_tx_done(fake(), 0))
    test.assert(canboard.bus_tx_done(fake(), 1) == false)
    let busy = fake_with(true, true, true, false, 0, 0, 0)
    test.assert(canboard.bus_tx_done(busy, 0) == false)

@test
fn test_a_receive_answers_the_frame_or_none() [io, hw]
    test.case("a pending frame crosses to a canframe; an empty controller answers none")
    let f = canboard.bus_receive(fake())
    test.assert_eq(canframe.frame_id(f), 0x123)
    test.assert_eq(canframe.frame_byte(f, 0), 0x7F)
    let empty = fake_with(true, true, false, true, 0, 0, 0)
    test.assert(canframe.is_none(canboard.bus_receive(empty)))

@test
fn test_the_counters_and_bus_off_cross_from_the_controller() [io, hw]
    test.case("counters pass through; a bus-off controller reads as a transmit counter at the limit; recovery is offered only when it may transmit")
    let e = fake_with(true, true, true, true, 40, 7, 0)
    let s = canboard.bus_state(e)
    test.assert_eq(canbus.tx_errors(s), 40)
    test.assert_eq(canbus.rx_errors(s), 7)
    test.assert(canboard.bus_recover(e) == None)
    let off = fake_with(true, true, true, true, 0, 9, 2)
    test.assert_eq(canbus.tx_errors(canboard.bus_state(off)), canbus.CAN_BUS_OFF_LIMIT)
    test.assert_eq(canbus.rx_errors(canboard.bus_state(off)), 9)
    test.assert(canboard.bus_recover(off) == Some(CanBusOff))
