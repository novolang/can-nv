// board_probe.nv — the device half, `canboard.CanBoard`, on a board
// whose controller serves `hal.can`, one line per result over the
// board's console.
//
// It is not a test of the host.  The FRDM-MCXN947's tests/can.sh builds
// it from this package's directory with `--target=frdm-mcxn947 --cov`,
// runs it on the board, checks every line and reads the coverage of
// src/canboard.nv out of the board's RAM.  The controller runs in
// loopback, so a frame sent is received; one section opens it in normal
// mode, where no other node acknowledges, to read the counters the
// device half reports and its refusal of a frame while the last one
// waits for the bus; another hands the TX pin back to GPIO, so the
// controller reads its own dominant bits back recessive and goes
// bus-off.

use embedded_hal.{ BoardCan }
use canframe
use canfilter
use canbus
use canhal
use canboard
use canboard.{ CanBoard }

fn line(label: Str, v: Int) [hw]
    hal.uart.write(label)
    hal.uart.write(str.from_int(v))
    hal.uart.write("\n")

fn flag(b: Bool) -> Int
    if b
        return 1
    return 0

// The next frame, waiting at most 20 ms.
fn next_frame(c: CanBoard) -> CanFrame [hw]
    let t0 = hal.timer.ticks_us()
    while hal.timer.ticks_us() - t0 < 20000
        let f = c.can_receive()
        if not canframe.is_none(f)
            return f
    canframe.none()

fn opening() [hw]
    let bad = canboard.board_open(0, 47000, true)
    line("bad rate started=", flag(canboard.board_started(bad)))
    let c = canboard.board_open(0, 250000, true)
    line("started=", flag(canboard.board_started(c)))
    line("bitrate=", canboard.board_bitrate(c))

fn loopback() [hw]
    let c = canboard.board_open(0, 250000, true)
    let a = c.can_transmit(canframe.frame_ext(0x18DAF110, 8, 0x1122334455667788))
    line("accepted=", flag(canhal.tx_ok(a)))
    line("mailbox=", canhal.accepted_mailbox(a))
    let t0 = hal.timer.ticks_us()
    while not c.can_tx_done(0) and hal.timer.ticks_us() - t0 < 20000
        pass
    line("sent=", flag(c.can_tx_done(0)))
    line("other mailbox done=", flag(c.can_tx_done(1)))
    let got = next_frame(c)
    line("id=", canframe.frame_id(got))
    line("ext=", flag(canframe.is_extended(got)))
    line("byte 0=", canframe.frame_byte(got, 0))
    line("byte 7=", canframe.frame_byte(got, 7))
    line("empty=", flag(canframe.is_none(c.can_receive())))
    // A standard frame with no data, and a remote frame through the
    // trait's checked transmit.
    let s = c.can_transmit(canframe.frame(0x7FF, 0, 0))
    line("std accepted=", flag(canhal.tx_ok(s)))
    let sb = next_frame(c)
    line("std id=", canframe.frame_id(sb))
    line("std len=", canframe.frame_len(sb))
    let r = canhal.transmit_checked(c, canframe.remote_frame(0x2AA, 3))
    line("remote accepted=", flag(canhal.tx_ok(r)))
    let back = next_frame(c)
    line("remote=", flag(canframe.is_remote(back)))
    line("remote len=", canframe.frame_len(back))
    line("remote ext=", flag(canframe.is_extended(back)))
    line("remote id=", canframe.frame_id(back))
    let _ = c.can_transmit(canframe.remote_frame_ext(0x1ABCDE, 2))
    let backx = next_frame(c)
    line("remote ext id=", canframe.frame_id(backx))
    line("remote ext ext=", flag(canframe.is_extended(backx) and canframe.is_remote(backx)))
    // Filtered in software: the frame 0x100 is skipped, 0x101 taken.
    let _ = c.can_transmit(canframe.frame(0x100, 1, 1))
    let t1 = hal.timer.ticks_us()
    while not c.can_tx_done(0) and hal.timer.ticks_us() - t1 < 20000
        pass
    let only = canfilter.exact(0x101)
    line("filtered none=", flag(canframe.is_none(canhal.receive_filtered(c, only, 4))))
    let _ = c.can_transmit(canframe.frame(0x101, 1, 2))
    var hit = canframe.none()
    let t2 = hal.timer.ticks_us()
    while canframe.is_none(hit) and hal.timer.ticks_us() - t2 < 20000
        hit = canhal.receive_filtered(c, only, 4)
    line("filtered id=", canframe.frame_id(hit))
    line("refused=", canhal.tx_status(c.can_transmit(canframe.frame(0x800, 0, 0))))
    line("abort refused=", flag(c.can_tx_abort(0) != None))
    line("filter refused=", flag(c.can_set_filter(0, canfilter.accept_all()) != None))
    line("slots=", c.can_filter_slots())
    line("recover=", flag(c.can_recover() == None))
    line("recover if bus off=", flag(canhal.recover_if_bus_off(c) == None))
    line("state=", canbus.state_of(c.can_bus_state()))

// Alone on the bus: the frame is never acknowledged, the transmit
// counter rises, and the next frame is refused while it waits.
fn alone() [hw]
    let c = canboard.board_open(0, 500000, false)
    line("normal started=", flag(canboard.board_started(c)))
    let a = c.can_transmit(canframe.frame(0x456, 2, 0x0102))
    line("normal accepted=", flag(canhal.tx_ok(a)))
    hal.timer.delay_ms(50)
    line("normal done=", flag(c.can_tx_done(0)))
    line("normal full=", canhal.tx_status(c.can_transmit(canframe.frame(0x457, 0, 0))))
    let st = c.can_bus_state()
    line("normal tx errors=", canbus.tx_errors(st))
    line("normal rx errors=", canbus.rx_errors(st))
    line("normal state=", canbus.state_of(st))
    line("normal recover=", flag(c.can_recover() == None))
    line("normal checked=", canhal.tx_status(canhal.transmit_checked(c, canframe.frame(0x458, 0, 0))))

// Bus-off: in normal mode at 125 kbit/s with the TX pin handed back to
// GPIO, its pull-up holding the transceiver's TXD recessive, every
// dominant bit the controller sends reads back recessive, a bit error
// that adds 8 to the transmit counter, so the node goes bus-off after 32
// of them.  It recovers by itself after 128 sequences of 11 recessive
// bits, about 11 ms at this rate, so the device half is read the moment
// the controller reports bus-off.
fn bus_off() [hw]
    let c = canboard.board_open(0, 125000, false)
    hal.gpio.mode(bsp.board.can_txd(), 2)
    let _ = c.can_transmit(canframe.frame(0x123, 1, 0x55))
    var seen = false
    let t0 = hal.timer.ticks_us()
    while not seen and hal.timer.ticks_us() - t0 < 200000
        seen = canbus.state_of(c.can_bus_state()) == canbus.CAN_STATE_BUS_OFF
    line("bus off seen=", flag(seen))
    line("bus off refused=", canhal.tx_status(c.can_transmit(canframe.frame(0x124, 0, 0))))
    line("bus off recover=", flag(c.can_recover() != None))

@tier(embedded)
fn main() [hw]
    bsp.board.init()
    opening()
    loopback()
    alone()
    bus_off()
    // Back in loopback, so the controller stops sending.
    let c = canboard.board_open(0, 500000, true)
    line("reopened=", flag(canboard.board_started(c)))
    hal.uart.write("probe done\n")
    while true
        hal.timer.delay_ms(1000)
